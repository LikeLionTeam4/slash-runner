{
  "name": "@slash-agent/contract-agent",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx src/cli.ts",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --external:ws --external:zod",
    "test": "vitest run"
  },
  "dependencies": {
    "@slash-agent/contracts": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
